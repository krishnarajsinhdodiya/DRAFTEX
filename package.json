{
  "name": "draftex",
  "version": "0.8.0",
  "private": true,
  "description": "Local-first question-paper builder that compiles to PDF through LaTeX.",
  "type": "module",
  "engines": {
    "node": ">=24.22.2 <25"
  },
  "scripts": {
    "dev": "node scripts/start.ts --dev",
    "build": "next build",
    "start": "node scripts/start.ts",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "next typegen && tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run --coverage",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:golden": "vitest run --config vitest.golden.config.ts",
    "hygiene": "node scripts/commit-hygiene.mjs --range HEAD",
    "db:generate": "prisma generate",
    "db:migrate": "node scripts/db-migrate.ts",
    "backup": "node scripts/backup.ts",
    "restore": "node scripts/restore.ts",
    "move-data": "node scripts/move-data.ts",
    "reset-password": "node scripts/reset-password.ts",
    "setup:tectonic": "node scripts/setup-tectonic.ts",
    "catalogue:parse": "node scripts/parse-syllabus.ts",
    "catalogue:check": "node scripts/parse-syllabus.ts --check",
    "postinstall": "prisma generate"
  },
  "dependencies": {
    "@node-rs/argon2": "2.2.2",
    "@prisma/adapter-better-sqlite3": "7.10.1",
    "@prisma/client": "7.10.1",
    "@radix-ui/react-dialog": "1.3.1",
    "@radix-ui/react-popover": "1.3.1",
    "@resvg/resvg-js": "2.6.2",
    "@tiptap/core": "3.32.2",
    "@tiptap/extension-bold": "3.32.2",
    "@tiptap/extension-document": "3.32.2",
    "@tiptap/extension-hard-break": "3.32.2",
    "@tiptap/extension-italic": "3.32.2",
    "@tiptap/extension-list": "3.32.2",
    "@tiptap/extension-paragraph": "3.32.2",
    "@tiptap/extension-subscript": "3.32.2",
    "@tiptap/extension-superscript": "3.32.2",
    "@tiptap/extension-table": "3.32.2",
    "@tiptap/extension-text": "3.32.2",
    "@tiptap/extension-underline": "3.32.2",
    "@tiptap/extensions": "3.32.2",
    "@tiptap/pm": "3.32.2",
    "@tiptap/react": "3.32.2",
    "@tiptap/suggestion": "3.32.2",
    "better-sqlite3": "12.11.1",
    "fflate": "0.8.3",
    "lucide-react": "1.67.0",
    "mathlive": "0.111.4",
    "next": "16.4.4",
    "pdfjs-dist": "6.5.438",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "sharp": "0.35.5",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@napi-rs/canvas": "1.1.0",
    "@playwright/test": "1.64.1",
    "@tailwindcss/postcss": "4.3.3",
    "@types/better-sqlite3": "9.6.0",
    "@types/node": "24.19.2",
    "@types/pngjs": "6.0.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitest/coverage-v8": "5.1.0",
    "eslint": "10.14.0",
    "eslint-config-next": "16.4.4",
    "pixelmatch": "8.0.0",
    "pngjs": "7.0.0",
    "prettier": "3.9.10",
    "prisma": "7.10.1",
    "tailwindcss": "4.3.3",
    "typescript": "6.0.3",
    "vitest": "5.1.0"
  },
  "overrides": {
    "eslint-plugin-react": {
      "eslint": "$eslint"
    },
    "eslint-plugin-jsx-a11y": {
      "eslint": "$eslint"
    },
    "eslint-plugin-import": {
      "eslint": "$eslint"
    }
  },
  "allowScripts": {
    "better-sqlite3@12.11.1": true,
    "prisma@7.10.1": true,
    "@prisma/engines@7.10.1": true
  }
}
