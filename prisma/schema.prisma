// DRAFTEX data model (SPEC §6). Model and field names are binding.
// SQLite only in v1 (memory.md); keep to features Postgres also has.
// Every read and write goes through src/lib/data, which enforces ownership.

generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "esm"
}

datasource db {
  provider = "sqlite"
}

enum Role {
  ADMIN
  FACULTY
}

enum Program {
  B_PHARM
  M_PHARM
  PHARM_D
}

enum ExamKind {
  SESSIONAL_1
  SESSIONAL_2
  SESSIONAL_IMPROVEMENT
  END_SEMESTER
  YEAR_END
  SUPPLEMENTARY_ATKT
  PRACTICAL_SESSIONAL
  PRACTICAL_END
  SYNOPSIS
  CUSTOM
}

enum CourseKind {
  THEORY
  PRACTICAL
  PROJECT
  INTERNSHIP
}

enum Visibility {
  PRIVATE
  GLOBAL
}

enum PaperStatus {
  DRAFT
  FINAL
  /// Set by a successful export only (D55).
  PRINTED
}

/// Why a version snapshot was taken (D57).
enum SnapshotReason {
  FINAL
  EXPORT
}

enum BankSharing {
  PRIVATE
  SHARED
}

enum BloomLevel {
  REMEMBER
  UNDERSTAND
  APPLY
  ANALYZE
  EVALUATE
  CREATE
}

enum CompileKind {
  PAPER
  KEY
}

enum CompileStatus {
  QUEUED
  RUNNING
  SUCCEEDED
  FAILED
  CANCELLED
}

model User {
  id                 String   @id @default(uuid())
  name               String
  /// Stored lower-cased and trimmed.
  email              String   @unique
  passwordHash       String
  role               Role     @default(FACULTY)
  institution        String?
  isActive           Boolean  @default(true)
  /// Set when an admin chose the password; the user must replace it at next sign-in.
  mustChangePassword Boolean  @default(false)
  /// Admin-enabled: the user may add Advanced LaTeX blocks (sanitised) to questions.
  allowAdvancedLatex Boolean  @default(false)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  sessions       Session[]
  invitesCreated InviteCode[]      @relation("InviteCreator")
  invitesUsed    InviteCode[]      @relation("InviteUser")
  templates      Template[]
  papers         Paper[]
  assets         Asset[]
  questions      Question[]
  questionUses   QuestionUse[]
  courseShares   BankCourseShare[]
  auditLogs      AuditLog[]
  loginLocks     LoginLock[]
}

/// Wrong passwords per account and client address (D38): five in a row from
/// one address lock that address out of that account for 15 minutes; other
/// addresses, the server machine included, can still sign in.
model LoginLock {
  userId      String
  address     String
  failures    Int       @default(0)
  lockedUntil DateTime?
  updatedAt   DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, address])
  @@index([updatedAt])
}

model Session {
  /// SHA-256 (hex) of the token in the cookie; the token itself is never stored.
  id        String   @id
  userId    String
  createdAt DateTime @default(now())
  /// Idle expiry: moved forward while the session is used.
  expiresAt DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

model InviteCode {
  /// SHA-256 (hex) of the code; the code is shown once and never stored.
  id          String    @id
  role        Role      @default(FACULTY)
  createdById String
  createdAt   DateTime  @default(now())
  expiresAt   DateTime
  usedAt      DateTime?
  usedById    String?
  revokedAt   DateTime?
  /// Short label so the admin can tell invites apart, e.g. "for Dr Shah".
  note        String?

  createdBy User  @relation("InviteCreator", fields: [createdById], references: [id])
  usedBy    User? @relation("InviteUser", fields: [usedById], references: [id])

  @@index([createdById])
}

model Course {
  id               String     @id @default(uuid())
  code             String     @unique
  title            String
  program          Program
  semesterOrYear   Int
  courseKind       CourseKind
  credits          Float
  lectureHrs       Int
  tutorialHrs      Int
  practicalHrs     Int
  maxMarks         Int
  sessionalMarks   Int
  endSemMarks      Int
  endSemMinutes    Int
  ruleSetId        String?
  /// Continuous-mode internal marks (Table X); not a question paper.
  continuousMarks  Int        @default(0)
  /// Sessional exam duration; null when there is no sessional exam.
  sessionalMinutes Int?
  /// Contact hours for the whole course, from its syllabus page.
  maxHours         Int?
  /// Elective options: the slot code they fill (e.g. BP607T) and its label.
  electiveOf       String?
  electiveLabel    String?
  /// Page of the PCI 2026 syllabus PDF the course was read from.
  syllabusPage     Int?

  outcomes  CourseOutcome[]
  units     CourseUnit[]
  papers    Paper[]
  questions Question[]
}

model CourseOutcome {
  id       String @id @default(uuid())
  courseId String
  number   Int
  text     String

  course Course @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@unique([courseId, number])
}

model CourseUnit {
  id       String @id @default(uuid())
  courseId String
  number   Int
  title    String
  hours    Int

  course Course @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@unique([courseId, number])
}

model Template {
  id              String     @id @default(uuid())
  title           String
  description     String     @default("")
  ownerId         String
  visibility      Visibility @default(PRIVATE)
  /// Seed templates: global, read-only, shown as "Built-in".
  builtIn         Boolean    @default(false)
  /// Stable id of a built-in in src/lib/templates/seeds; null for user templates.
  seedKey         String?    @unique
  program         Program
  examKind        ExamKind
  courseKind      CourseKind
  creditTier      Int?
  ruleSetId       String?
  durationMinutes Int
  maxMarks        Float
  /// Zod-validated in src/lib/paper/schema.ts.
  structure       Json
  style           Json
  header          Json
  derivedFromId   String?
  deletedAt       DateTime?
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt
  version         Int        @default(1)

  owner       User       @relation(fields: [ownerId], references: [id])
  derivedFrom Template?  @relation("TemplateDerivation", fields: [derivedFromId], references: [id], onDelete: SetNull)
  derived     Template[] @relation("TemplateDerivation")
  papers      Paper[]

  @@index([ownerId])
  @@index([visibility, deletedAt])
}

model Paper {
  id                   String      @id @default(uuid())
  ownerId              String
  templateId           String?
  /// Copy of the template's structure, style and header when the paper was made.
  templateSnapshot     Json
  title                String
  courseId             String?
  courseCode           String
  courseTitle          String
  program              Program
  semesterOrYear       Int
  examKind             ExamKind
  academicYear         String
  examDate             DateTime?
  instructionsOverride Json?
  status               PaperStatus @default(DRAFT)
  derivedFromPaperId   String?
  createdAt            DateTime    @default(now())
  updatedAt            DateTime    @updatedAt
  version              Int         @default(1)
  /// Set when the paper is moved to Trash (D51); removed for good 30 days later.
  deletedAt            DateTime?
  /// Time of the last successful export (D55).
  printedAt            DateTime?

  owner            User            @relation(fields: [ownerId], references: [id])
  template         Template?       @relation(fields: [templateId], references: [id], onDelete: SetNull)
  course           Course?         @relation(fields: [courseId], references: [id], onDelete: SetNull)
  derivedFromPaper Paper?          @relation("PaperDerivation", fields: [derivedFromPaperId], references: [id], onDelete: SetNull)
  derivedPapers    Paper[]         @relation("PaperDerivation")
  slots            Slot[]
  compileJobs      CompileJob[]
  snapshots        PaperSnapshot[]
  bankQuestions    Question[]      @relation("QuestionSource")
  questionUses     QuestionUse[]

  @@index([ownerId, deletedAt])
  @@index([templateId])
}

model Slot {
  id          String      @id @default(uuid())
  paperId     String
  partKey     String
  groupKey    String
  position    Int
  /// TipTap JSON, validated by docSchema.
  content     Json
  marks       Float
  coTag       String?
  bloomLevel  BloomLevel?
  answerKey   Json?
  keyCriteria Json?
  /// The bank question this one was inserted from or added to (Phase 11).
  questionId  String?

  paper    Paper     @relation(fields: [paperId], references: [id], onDelete: Cascade)
  question Question? @relation(fields: [questionId], references: [id], onDelete: SetNull)

  @@unique([paperId, partKey, groupKey, position])
}

/// Future question bank (SPEC §14). Empty in v1.
/// A question in the bank (Phase 11). Private to its author unless shared on
/// its own (SHARED) or through a course share (D73). Every column added in
/// Phase 11 is optional in the database; the data layer requires course code,
/// CO, Bloom, marks, type and content on every save.
model Question {
  id            String      @id @default(uuid())
  ownerId       String
  createdAt     DateTime    @default(now())
  /// Catalogue course, when the question is for one (D72).
  courseId      String?
  /// The course as printed (catalogue code, or typed for courses outside the
  /// catalogue); duplicates and course shares go by this code (D72 amended).
  courseCode    String?
  courseTitle   String?
  program       Program?
  /// Unit number of the course (CourseUnit.number); optional.
  unit          Int?
  coTag         String?
  bloomLevel    BloomLevel?
  marks         Float?
  /// Group type the question is written for (OBJECTIVE, SHORT, ...).
  type          String?
  /// TipTap JSON, validated by docSchema (same as a slot).
  content       Json?
  answerKey     Json?
  keyCriteria   Json?
  /// Free tags, a JSON array of strings.
  tags          Json?
  /// Duplicate key (D76): SHA-256 of the normalised question.
  dupKey        String?
  /// Plain text of the question for search.
  searchText    String?
  sharing       BankSharing @default(PRIVATE)
  /// The paper the question was added from, while it exists.
  sourcePaperId String?
  updatedAt     DateTime?   @updatedAt
  version       Int         @default(1)
  /// Set when the question is moved to Trash (D82); removed for good 30 days later.
  deletedAt     DateTime?

  owner       User          @relation(fields: [ownerId], references: [id])
  course      Course?       @relation(fields: [courseId], references: [id], onDelete: SetNull)
  sourcePaper Paper?        @relation("QuestionSource", fields: [sourcePaperId], references: [id], onDelete: SetNull)
  slots       Slot[]
  uses        QuestionUse[]

  @@index([ownerId])
  @@index([ownerId, courseCode, dupKey])
  @@index([courseCode, sharing])
}

/// One use of a bank question in a paper (D75); each user sees only their own.
model QuestionUse {
  id         String   @id @default(uuid())
  questionId String
  userId     String
  paperId    String?
  /// The paper's title when the question was used; kept after the paper goes.
  paperTitle String
  usedAt     DateTime @default(now())

  question Question @relation(fields: [questionId], references: [id], onDelete: Cascade)
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  paper    Paper?   @relation(fields: [paperId], references: [id], onDelete: SetNull)

  @@index([questionId, userId, usedAt])
  @@index([userId])
}

/// "Share all my questions of this course" (D73): covers current and future
/// ones; by course code so courses outside the catalogue can be shared too.
model BankCourseShare {
  ownerId    String
  courseCode String
  createdAt  DateTime @default(now())

  owner User @relation(fields: [ownerId], references: [id], onDelete: Cascade)

  @@id([ownerId, courseCode])
  @@index([courseCode])
}

/// One row per owner and file; the file itself is stored once as assets/<sha256>.<ext>.
model Asset {
  sha256       String
  ownerId      String
  mime         String
  bytes        Int
  width        Int?
  height       Int?
  originalName String
  createdAt    DateTime @default(now())

  owner User @relation(fields: [ownerId], references: [id])

  @@id([ownerId, sha256])
  @@index([sha256])
}

model CompileJob {
  /// Increasing, so "newest 20" is exact even when two jobs share a millisecond.
  id           Int           @id @default(autoincrement())
  paperId      String
  kind         CompileKind
  status       CompileStatus
  durationMs   Int?
  errorSummary String?
  createdAt    DateTime      @default(now())

  paper Paper @relation(fields: [paperId], references: [id], onDelete: Cascade)

  @@index([paperId, createdAt])
}

model AuditLog {
  id       String   @id @default(uuid())
  /// Null for events with no signed-in actor (e.g. a failed sign-in).
  actorId  String?
  action   String
  entity   String
  entityId String?
  /// Short non-confidential context, such as a client address or a network mode.
  detail   String?
  at       DateTime @default(now())

  actor User? @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@index([at])
}

/// A version of a paper kept when it is marked Final or exported (D57).
/// `data` holds the paper's details, template snapshot, questions and keys;
/// the PDF is compiled again when the snapshot is viewed. Newest 20 per paper (D58).
model PaperSnapshot {
  id        String         @id @default(uuid())
  paperId   String
  reason    SnapshotReason
  /// SHA-256 of `data`, so identical content is not stored twice.
  sha256    String
  data      Json
  createdAt DateTime       @default(now())

  paper Paper @relation(fields: [paperId], references: [id], onDelete: Cascade)

  @@index([paperId, createdAt])
}
